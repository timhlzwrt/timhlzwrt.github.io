---
/**
 * One pane on the pond: frosted glass, so the sharks swimming underneath show
 * through as blurred colour and come out sharp on the other side. Rounded
 * like the stones they stand in for.
 */
interface Props {
  id: string;
  heading: string;
  class?: string;
}

const { id, heading, class: className } = Astro.props;
---

<section
  id={id}
  data-pane
  class:list={["glass rounded-2xl border border-rule/70 px-6 py-8 sm:px-10 sm:py-10", className]}
  aria-labelledby={`${id}-heading`}
>
  <h2
    id={`${id}-heading`}
    class="mb-6 font-display text-[1.75rem] font-semibold leading-none tracking-[-0.02em] [font-stretch:115%] sm:text-[2rem]"
  >
    {heading}
  </h2>
  <slot />
</section>
