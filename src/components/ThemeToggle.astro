---
/**
 * Two states of one glyph rather than a sun/moon pair. Less decoration,
 * and it matches the hairline weight of everything else on the page.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  class="label flex h-full min-w-11 cursor-pointer items-center justify-center rounded-xl transition-colors hover:!text-accent"
  aria-label={label}
>
  <svg
    width="13"
    height="13"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
    aria-hidden="true"
  >
    <circle cx="8" cy="8" r="5.5"></circle>
    <path d="M8 2.5a5.5 5.5 0 0 1 0 11z" fill="currentColor" stroke="none"></path>
  </svg>
</button>

<script>
  const toggle = document.getElementById("theme-toggle");

  // Pressed means dark. Set here rather than in the markup because the theme
  // is decided by the inline script in <head>, so the server-rendered value
  // would be wrong for half of all visitors.
  // The theme-color tags in Base.astro only know the OS setting, so a theme
  // picked here would leave the browser's toolbar in the other colour.
  const themeColors = document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]');
  const [lightColor, darkColor] = Array.from(themeColors, (meta) => meta.content);
  const sync = (dark: boolean) => {
    toggle?.setAttribute("aria-pressed", String(dark));
    themeColors.forEach((meta) => (meta.content = dark ? darkColor : lightColor));
  };

  sync(document.documentElement.classList.contains("dark"));

  const flip = () => {
    const dark = document.documentElement.classList.toggle("dark");
    sync(dark);
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {
      /* storage blocked; the choice just won't persist */
    }
  };

  // A crossfade instead of a hard cut, where the browser can do one and
  // the visitor has not asked for less motion.
  toggle?.addEventListener("click", () => {
    const calm = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (document.startViewTransition && !calm) document.startViewTransition(flip);
    else flip();
  });

  // Follow the OS until the visitor states a preference of their own.
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
    try {
      if (localStorage.getItem("theme")) return;
    } catch {
      /* ignore */
    }
    document.documentElement.classList.toggle("dark", event.matches);
    sync(event.matches);
  });
</script>
