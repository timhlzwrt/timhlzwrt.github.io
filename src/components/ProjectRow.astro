---
import type { Project, Status } from "~/data/projects";
import { formatMonth, type RepoStats } from "~/lib/github";

interface Props {
  project: Project;
  stats?: RepoStats;
  index: number;
}

const { project, stats, index } = Astro.props;

const statusTone: Record<Status, string> = {
  live: "text-accent-strong",
  shipped: "text-foreground",
  paused: "text-muted-foreground",
  unmaintained: "text-muted-foreground",
};

// Language and date come from GitHub; if the fetch failed they simply
// drop out of the row rather than rendering "null" or a dash.
const meta = [
  stats?.language,
  formatMonth(stats?.pushedAt),
  // A wall of "0 ★" would say nothing, so stars only appear once earned.
  stats?.stars ? `${stats.stars} ★` : null,
].filter(Boolean) as string[];

const ordinal = String(index + 1).padStart(2, "0");
---

<article
  class="group relative grid grid-cols-[1.75rem_1fr] gap-x-2 border-t border-rule py-6 sm:gap-x-4"
>
  {/* Hairline that lights up on hover — the row's only affordance. */}
  <span
    aria-hidden="true"
    class="absolute -top-px left-0 h-px w-0 bg-accent transition-[width] duration-300 ease-out group-hover:w-full"
  ></span>

  <div
    class="label pt-[0.4rem] tabular-nums transition-colors group-hover:text-accent-strong"
  >
    {ordinal}
  </div>

  <div class="min-w-0">
    {/* Stacked on phones — side by side the metadata crowds the title and
        runs into the right edge. Baseline-aligned from sm up. */}
    <div
      class="flex flex-col gap-1.5 sm:flex-row sm:flex-wrap sm:items-baseline sm:justify-between sm:gap-x-6 sm:gap-y-1"
    >
      <h3 class="font-display text-2xl leading-none sm:text-[1.75rem]">
        {project.name}
      </h3>

      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 sm:gap-x-4">
        {meta.map((item) => <span class="label tabular-nums">{item}</span>)}
        <span class:list={["label", statusTone[project.status]]}>
          {project.status}
        </span>
      </div>
    </div>

    <p class="mt-3 max-w-[62ch] text-[0.8125rem] leading-relaxed text-muted-foreground">
      {project.blurb}
    </p>

    {
      project.links && (
        <div class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
          {project.links.map((link) => (
            <a
              href={link.href}
              rel="noopener"
              class="label underline decoration-rule underline-offset-4 transition-colors hover:!text-accent-strong hover:decoration-accent-strong"
            >
              {link.label}
              <span aria-hidden="true"> ↗</span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</article>
