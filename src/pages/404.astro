---
import Base from "~/layouts/Base.astro";

/**
 * GitHub Pages serves a top-level 404.html for any unmatched path, including
 * on a custom domain. Astro emits this route to exactly that filename, so
 * nothing extra is needed to wire it up.
 */
---

<Base title="Not found" noindex description="That page isn't here.">
  <section class="pt-20 sm:pt-28">
    <p class="label">Error</p>
    <h1
      class="font-display mt-4 text-[clamp(4rem,16vw,8rem)] leading-[0.8] tracking-tight tabular-nums"
    >
      404
    </h1>
  </section>

  <div class="mt-14 border-t border-foreground pt-6">
    <p class="max-w-[52ch] text-[0.875rem] leading-relaxed">
      That page isn't in the index — wrong address, or something that used to be
      here and isn't any more.
    </p>

    <p class="mt-6">
      <a
        href="/"
        class="text-sm underline decoration-rule underline-offset-4 transition-colors hover:text-accent-strong hover:decoration-accent-strong"
      >
        <span aria-hidden="true">← </span>Back to the index
      </a>
    </p>
  </div>
</Base>
