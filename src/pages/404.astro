---
import Base from "~/layouts/Base.astro";
import { content } from "~/i18n/content";

/**
 * GitHub Pages serves exactly one top-level 404.html for every unmatched
 * path, so this page can't know which language was wanted. It shows both
 * rather than guessing, which is also the cheapest way to make the German
 * side of the site not feel like an afterthought.
 */
const en = content.en;
const de = content.de;
---

<Base locale="en" title="404" noindex showNav={false} description="Page not found.">
  <section class="pt-20 sm:pt-28">
    <p class="label">{en.notFound.label} · {de.notFound.label}</p>
    <h1
      class="mt-4 font-display text-[clamp(4rem,16vw,8rem)] leading-[0.8] tracking-tight tabular-nums"
    >
      4<span class="initial">0</span>4
    </h1>
  </section>

  <div class="mt-14 space-y-6 border-t border-foreground pt-6">
    <div class="max-w-[52ch]">
      <p class="text-[0.875rem] leading-relaxed">{en.notFound.body}</p>
      <p class="mt-2">
        <a href="/" class="text-sm link-underline">
          <span aria-hidden="true">← </span>{en.notFound.back}
        </a>
      </p>
    </div>

    <div class="max-w-[52ch] border-t border-rule pt-6" lang="de">
      <p class="text-[0.875rem] leading-relaxed">{de.notFound.body}</p>
      <p class="mt-2">
        <a href="/de/" class="text-sm link-underline">
          <span aria-hidden="true">← </span>{de.notFound.back}
        </a>
      </p>
    </div>
  </div>
</Base>
