---
import "~/styles/global.css";
import { content, profile, SECTIONS, type Locale } from "~/i18n/content";
import { alternatePath, otherLocale } from "~/i18n/utils";
import { fetchLastGame } from "~/lib/steam";
import { ACCENT } from "~/data/accent";
import { accentChoices } from "~/lib/palette";
import ThemeToggle from "~/components/ThemeToggle.astro";
import LangSwitch from "~/components/LangSwitch.astro";
import StatusWidget from "~/components/StatusWidget.astro";
// The same files the @font-face rules in global.css point at, so Vite emits
// one asset for both and the preload is not a second download.
import monaSans from "@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url";
import plexMono from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /**
   * Set on pages that shouldn't be indexed and have no URL of their own or
   * other-language twin (the 404): drops the canonical, hreflang, og:url and
   * the language switch, which would all point at pages that don't exist.
   */
  noindex?: boolean;
  /** Section links in the bottom bar. Omitted on the 404 page. */
  showNav?: boolean;
}

const { locale, title, description, noindex = false, showNav = true } = Astro.props;

const t = content[locale];
const other = otherLocale(locale);
const pathname = Astro.url.pathname;

const pageTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.domain}`;
const pageDescription = description ?? t.meta.description;
const canonical = new URL(pathname, Astro.site ?? profile.url).href;
const alternateHref = new URL(alternatePath(other, pathname), Astro.site ?? profile.url).href;

// Static card, committed rather than generated per page: there is only one
// page per locale and the artwork is locale-neutral. See scripts/generate-og.mjs.
const ogImage = new URL("/og.png", Astro.site ?? profile.url).href;

/**
 * Ties tjh.li, GitHub and X together as one identity for search engines: the
 * same job `rel="me"` does on the contact links, in the format crawlers
 * actually read. Baked into the HTML as static JSON, so it costs no script
 * execution and no third-party request, and `sameAs` is derived from the
 * contact links rather than repeated, so the two can't drift.
 */
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  url: profile.url,
  image: ogImage,
  jobTitle: t.hero.role,
  email: `mailto:${profile.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: profile.city,
    addressCountry: "DE",
  },
  sameAs: t.contact.links.map((link) => link.href).filter((href) => !href.startsWith("mailto:")),
};

// Baked in at build time like the repo stats, not fetched by the visitor.
// Null whenever the key is missing, the profile is private or the API is
// unhappy, in which case the line is simply omitted.
const lastGame = await fetchLastGame();

const nav = SECTIONS.map((id) => ({ id, label: t.nav[id] }));
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang={other} href={alternateHref} />
          <link rel="alternate" hreflang={locale} href={canonical} />
          <link
            rel="alternate"
            hreflang="x-default"
            href={new URL(alternatePath("en", pathname), Astro.site ?? profile.url).href}
          />
        </>
      )
    }
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    {/*
      Fetched alongside the stylesheet instead of after it: Mona Sans sets
      the hero name, the largest paint, and the pond waits for Plex Mono
      before it draws its first frame.
    */}
    <link rel="preload" href={monaSans} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexMono} as="font" type="font/woff2" crossorigin />
    <meta name="author" content={profile.name} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={locale === "de" ? "de_DE" : "en_GB"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {
      !noindex && (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
      )
    }

    <meta name="theme-color" content="#f2f4f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0d13" media="(prefers-color-scheme: dark)" />

    {/*
      One blocking script, run before first paint, doing three things that
      would otherwise cause a visible flash: pick the theme, roll the accent
      colour, and send German speakers to the German page.
    */}
    <script is:inline define:vars={{ palette: accentChoices(ACCENT) }}>
      (function () {
        var root = document.documentElement;

        // -- theme ------------------------------------------------------
        try {
          var stored = localStorage.getItem("theme");
          var dark = stored
            ? stored === "dark"
            : window.matchMedia("(prefers-color-scheme: dark)").matches;
          root.classList.toggle("dark", dark);
        } catch (e) {
          /* storage blocked; system preference already applies */
        }

        // -- accent -----------------------------------------------------
        // `palette` is injected by define:vars from the setting in
        // src/data/accent.ts: all six pairs for "daily", otherwise just the
        // pinned one, which the day index then always lands on. Picked from
        // the day, not the load, so the colour holds for the whole day.
        var dayIndex = Math.floor(Date.now() / 86400000) % palette.length;
        var pick = palette[dayIndex];
        root.style.setProperty("--accent-light", pick[0]);
        root.style.setProperty("--accent-dark", pick[1]);

        // -- language ---------------------------------------------------
        // Browser language, not IP geolocation: no third-party lookup, no
        // network request, and correct for a German speaker abroad.
        // Only ever redirects EN -> DE, once, and never overrides a choice
        // the visitor has already made with the switcher.
        try {
          // Only the English home page. That excludes /de/ implicitly, and
          // keeps the 404 and the /about/ redirect target out of it.
          var choice = localStorage.getItem("lang");

          if (!choice && location.pathname === "/") {
            var langs = navigator.languages || [navigator.language || ""];
            // Order matters: ["en-US","de-DE"] means English preferred, so
            // whichever of the two appears first wins. Matching "de"
            // anywhere in the list would override a stated preference.
            for (var i = 0; i < langs.length; i++) {
              var tag = String(langs[i]).toLowerCase();
              if (tag.indexOf("de") === 0) {
                // replace() so Back doesn't bounce between the two. The hash
                // carries over so /about/ -> /#about -> /de/#about keeps its
                // anchor instead of dumping you at the top of the page.
                location.replace("/de/" + location.hash);
                break;
              }
              if (tag.indexOf("en") === 0) break;
            }
          }
        } catch (e) {
          /* no storage or no navigator.languages; English stands */
        }
      })();
    </script>
  </head>

  <body class="min-h-dvh pb-16 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-foreground focus:px-3 focus:py-2 focus:text-xs focus:text-background"
    >
      {t.ui.skipToContent}
    </a>

    <div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
      <main id="main">
        <slot />
      </main>

      <footer
        class="glass mb-10 mt-20 rounded-2xl border border-rule/70 px-6 py-6 text-sm text-muted-foreground sm:px-10"
      >
        {/*
          Fetched when the page was built, not when it was opened, exactly
          like the repo metadata in the work section. "Last played" rather
          than "now playing" because the nightly rebuild means this can be a
          day behind, and a static page can't honestly claim live status.
        */}
        {
          lastGame && (
            <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-rule pb-5">
              <span class="label">{t.footer.lastPlayed}</span>
              <span class="flex items-baseline gap-x-3">
                <a href={lastGame.url} class="link-underline text-sm">
                  {lastGame.name}
                </a>
                {lastGame.hours > 0 && (
                  <span class="label tabular-nums">{lastGame.hours} h</span>
                )}
              </span>
            </div>
          )
        }

        <StatusWidget
          label={t.footer.status.label}
          operational={t.footer.status.operational}
          issues={t.footer.status.issues}
        />

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p>
            {profile.city} · <a href={`mailto:${profile.email}`} class="link-underline"
              >{profile.email}</a
            >
          </p>
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            <p>
              {t.footer.built}{" "}
              <a
                href={`https://github.com/${profile.handle}/timhlzwrt.github.io`}
                class="link-underline">{t.footer.source}</a
              >.
            </p>
            <p>
              <a href="#main" class="link-underline">
                <span aria-hidden="true">↑ </span>{t.ui.backToTop}
              </a>
            </p>
          </div>
        </div>
      </footer>
    </div>

    {/*
      Progressive blur under the bar: stacked layers, each blurring a little
      more and masked to a band a little lower, so whatever scrolls toward
      the bottom edge goes soft gradually rather than at one hard line.
    */}
    <div aria-hidden="true" class="progressive-blur pointer-events-none fixed inset-x-0 bottom-0 z-30 h-20 sm:h-28">
      <div></div>
      <div></div>
      <div></div>
      <div></div>
    </div>

    {/*
      One floating bar for everything: home, the sections, the language and
      the theme. At the bottom so it stays under the thumb on a phone. Every
      target is the full 44px height of the bar. Where the section links do
      not fit (a phone, a narrow window) they scroll sideways inside the
      bar, faded at the edges, and the current one is kept in view.
    */}
    <header
      class="fixed inset-x-3 bottom-3 z-40 mx-auto flex h-[3.375rem] max-w-fit items-center gap-1 glass rounded-2xl border border-rule/70 p-1 text-sm shadow-[0_8px_30px_-12px_rgb(0_0_0/0.35)] [view-transition-name:status-bar]"
    >
      {/* On the home page it scrolls back up instead of reloading the page. */}
      <a
        href={showNav ? "#main" : locale === "de" ? "/de/" : "/"}
        class="flex h-full shrink-0 items-center rounded-xl px-3 font-display font-bold tracking-[-0.01em] [font-stretch:125%] transition-colors hover:text-accent"
      >
        {profile.domain}
      </a>

      {
        showNav && (
          <nav
            id="section-nav"
            data-lenis-prevent
            class="flex h-full min-w-0 items-center overflow-x-auto [mask-image:linear-gradient(to_right,transparent,#000_1rem,#000_calc(100%-1rem),transparent)] [scrollbar-width:none] lg:[mask-image:none] [&::-webkit-scrollbar]:hidden"
            aria-label={t.ui.sectionsLabel}
          >
            {nav.map((item) => (
              <a
                href={`#${item.id}`}
                data-tab={item.id}
                class="flex h-full shrink-0 items-center rounded-xl px-3 text-muted-foreground transition-colors hover:text-foreground aria-[current=true]:bg-foreground/10 aria-[current=true]:text-foreground"
              >
                {item.label}
              </a>
            ))}
          </nav>
        )
      }

      <div class="flex h-full shrink-0 items-center border-l border-rule pl-1">
        {!noindex && <LangSwitch locale={locale} />}
        <ThemeToggle label={t.ui.themeLabel} />
      </div>
    </header>

    <script>
      import Lenis from "lenis";

      // Eased wheel and anchor scrolling. Lenis drives the real window
      // scroll, so scroll events, the observers and the pond's parallax all
      // keep working, and it turns itself off under prefers-reduced-motion.
      // A slightly lower lerp than the default gives the wheel a softer
      // glide; touch keeps the platform's own momentum, which feels right.
      new Lenis({ autoRaf: true, lerp: 0.085, anchors: { offset: -24 } });

      const tabs = new Map(
        Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-tab]"), (tab) => [
          tab.dataset.tab,
          tab,
        ]),
      );

      // A section counts as current while it crosses a line 40% down the
      // screen, so exactly one tab is lit at a time. Above the middle, so a
      // short last section can still reach it on a phone.
      const sectionNav = document.getElementById("section-nav");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const tab = tabs.get(entry.target.id);
            tab?.setAttribute("aria-current", String(entry.isIntersecting));
            // Where the links scroll sideways, bring the current one to the
            // middle so it is never hidden past the edge.
            if (tab && entry.isIntersecting && sectionNav) {
              sectionNav.scrollTo({
                left: tab.offsetLeft - (sectionNav.clientWidth - tab.offsetWidth) / 2,
                behavior: "smooth",
              });
            }
          }
        },
        { rootMargin: "-40% 0px -60% 0px" },
      );
      tabs.forEach((_, id) => {
        const section = id && document.getElementById(id);
        if (section) observer.observe(section);
      });


    </script>
  </body>
</html>
